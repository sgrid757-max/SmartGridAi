# ==========================================
# SmartGrid AI & AI Chatbot API Configuration
# ==========================================

# Active AI Provider: "gemini", "openai", or "groq"
AI_PROVIDER=gemini

# Google Gemini API Configuration
# Official models: gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Configuration (ChatGPT)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API Configuration (Fast LLaMA / GPT-OSS)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
